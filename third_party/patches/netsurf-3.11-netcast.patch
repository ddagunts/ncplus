+static void present(nsfb_t *nsfb)
+{
+    sdl2_priv *s = nsfb->surface_priv;
+    if (s == NULL || !s->is_dirty)
+        return;
+    nsfb_bbox_t d = s->dirty;
+    if (d.x0 < 0) d.x0 = 0;
+    if (d.y0 < 0) d.y0 = 0;
+    if (d.x1 > nsfb->width) d.x1 = nsfb->width;
+    if (d.y1 > nsfb->height) d.y1 = nsfb->height;
+    s->is_dirty = false;
+    if (d.x1 > d.x0 && d.y1 > d.y0) {
+        SDL_Rect r = { d.x0, d.y0, d.x1 - d.x0, d.y1 - d.y0 };
+        SDL_UpdateTexture(s->tex, &r, nsfb->ptr + d.y0 * nsfb->linelen + d.x0 * 4, nsfb->linelen);
+    }
+    SDL_RenderClear(s->ren);
+    SDL_RenderCopy(s->ren, s->tex, NULL, NULL);
+    SDL_RenderPresent(s->ren);
 }
 

--- a/src/audio/netcast/SDL_netcastaudio.c	1969-12-31 19:00:00.000000000 -0500
+++ b/src/audio/netcast/SDL_netcastaudio.c	2026-11-20 00:10:07.857090409 -0500
@@ -0,0 +1,267 @@
+/*
+  SDL audio driver for LG NetCast 4.x TVs (MT5398).
+
+  The TV has no ALSA playback devices; PCM goes through MediaTek's GStreamer 0.10
+  element "mtkaudiosink" (render-mode=1 = real MTAL output; 0 = fake, 2 = dump).
+  Pipeline:  appsrc name=src ! mtkaudiosink render-mode=1
+  GStreamer is dlopen'ed from the TV's /usr/local/lib at runtime.
+
+  Flash safety: GStreamer writes its plugin registry to $GST_REGISTRY, which LG points
+  at /mnt/flash/data. We force it into /tmp (RAM) before gst_init().
+*/
+#include "../../SDL_internal.h"
+
+#ifdef SDL_AUDIO_DRIVER_NETCAST
+
+#include "SDL_timer.h"
+#include "SDL_audio.h"
+#include "SDL_loadso.h"
+#include "../SDL_audio_c.h"
+#include "../SDL_sysaudio.h"
+
+#define _THIS SDL_AudioDevice *_this
+
+#include <stdint.h>
+#include <string.h>
+#include <unistd.h>
+
+/* --- minimal GStreamer 0.10 / GObject ABI (32-bit ARM) --- */
+typedef struct {
+    void *g_class;          /* GTypeInstance */
+    int refcount;
+    unsigned flags;
+    void *reserved;
+    uint8_t *data;          /* GST_BUFFER_DATA */
+    unsigned size;          /* GST_BUFFER_SIZE */
+} nc_GstBuffer;
+
+#define GST_STATE_NULL 1
+#define GST_STATE_PLAYING 4
+
+static void *gst_lib, *gstapp_lib, *gobj_lib;
+static int (*p_gst_init_check)(int *, char ***, void **);
+static void *(*p_gst_parse_launch)(const char *, void **);
+static void *(*p_gst_bin_get_by_name)(void *, const char *);
+static void *(*p_gst_caps_from_string)(const char *);
+static void (*p_gst_caps_unref)(void *);
+static int (*p_gst_element_set_state)(void *, int);
+static void (*p_gst_object_unref)(void *);
+static nc_GstBuffer *(*p_gst_buffer_new_and_alloc)(unsigned);
+static int (*p_gst_app_src_push_buffer)(void *, void *);
+static int (*p_gst_app_src_end_of_stream)(void *);
+static void (*p_g_object_set)(void *, const char *, ...);
+static int gst_ready;
+
+struct SDL_PrivateAudioData {
+    void *pipeline;
+    void *appsrc;
+    Uint8 *mixbuf;
+    Uint64 start_ms;
+    Uint64 bytes_pushed;
+    int bytes_per_sec;
+};
+
+static void *load_any(const char *const *names)
+{
+    for (; *names; names++) {
+        void *h = SDL_LoadObject(*names);
+        if (h) return h;
+    }
+    return NULL;
+}
+
+static void NETCAST_UnloadGst(void)
+{
+    if (gstapp_lib) SDL_UnloadObject(gstapp_lib);
+    if (gst_lib) SDL_UnloadObject(gst_lib);
+    if (gobj_lib) SDL_UnloadObject(gobj_lib);
+    gstapp_lib = gst_lib = gobj_lib = NULL;
+    gst_ready = 0;
+}
+
+static int NETCAST_LoadGst(void)
+{
+    static const char *const gst_names[] = { "libgstreamer-0.10.so.0", "/usr/local/lib/libgstreamer-0.10.so.0", NULL };
+    static const char *const app_names[] = { "libgstapp-0.10.so.0", "/usr/local/lib/libgstapp-0.10.so.0", NULL };
+    static const char *const gob_names[] = { "libgobject-2.0.so.0", "/usr/local/lib/libgobject-2.0.so.0", NULL };
+    const char *reg;
+
+    if (gst_ready) return 0;
+
+    /* never let GStreamer rewrite LG's registry on flash */
+    reg = SDL_getenv("GST_REGISTRY");
+    if (!reg || SDL_strncmp(reg, "/tmp/", 5) != 0) {
+        SDL_setenv("GST_REGISTRY", "/tmp/ncapp-gstreg.bin", 1);
+    }
+
+    gobj_lib = load_any(gob_names);
+    gst_lib = load_any(gst_names);
+    gstapp_lib = load_any(app_names);
+    if (!gobj_lib || !gst_lib || !gstapp_lib) {
+        NETCAST_UnloadGst();
+        return SDL_SetError("netcast audio: GStreamer 0.10 libraries not found");
+    }
+#define L(lib, sym) if (!(*(void **)&p_##sym = SDL_LoadFunction(lib, #sym))) { NETCAST_UnloadGst(); return -1; }
+    L(gst_lib, gst_init_check);
+    L(gst_lib, gst_parse_launch);
+    L(gst_lib, gst_bin_get_by_name);
+    L(gst_lib, gst_caps_from_string);
+    L(gst_lib, gst_caps_unref);
+    L(gst_lib, gst_element_set_state);
+    L(gst_lib, gst_object_unref);
+    L(gst_lib, gst_buffer_new_and_alloc);
+    L(gstapp_lib, gst_app_src_push_buffer);
+    L(gstapp_lib, gst_app_src_end_of_stream);
+    L(gobj_lib, g_object_set);
+#undef L
+    if (!p_gst_init_check(NULL, NULL, NULL)) {
+        NETCAST_UnloadGst();
+        return SDL_SetError("netcast audio: gst_init failed");
+    }
+    gst_ready = 1;
+    return 0;
+}
+
+static int nearest_rate(int f)
+{
+    static const int rates[] = { 8000, 11025, 16000, 22050, 32000, 44100, 48000 };
+    int best = 48000, i;
+    for (i = 0; i < (int)SDL_arraysize(rates); i++) {
+        if (rates[i] >= f) { best = rates[i]; break; }
+    }
+    return best;
+}
+
+static int NETCAST_OpenDevice(_THIS, const char *devname)
+{
+    struct SDL_PrivateAudioData *h;
+    char capsstr[160];
+    void *caps;
+
+    if (_this->iscapture) {
+        return SDL_SetError("netcast audio: capture not supported");
+    }
+    if (NETCAST_LoadGst() < 0) {
+        return -1;
+    }
+    h = (struct SDL_PrivateAudioData *)SDL_calloc(1, sizeof(*h));
+    if (!h) {
+        return SDL_OutOfMemory();
+    }
+    _this->hidden = h;
+
+    _this->spec.format = AUDIO_S16LSB;
+    if (_this->spec.channels > 2) _this->spec.channels = 2;
+    if (_this->spec.channels < 1) _this->spec.channels = 2;
+    _this->spec.freq = nearest_rate(_this->spec.freq);
+    SDL_CalculateAudioSpec(&_this->spec);
+
+    h->mixbuf = (Uint8 *)SDL_malloc(_this->spec.size);
+    if (!h->mixbuf) {
+        return SDL_OutOfMemory();
+    }
+    SDL_memset(h->mixbuf, _this->spec.silence, _this->spec.size);
+    h->bytes_per_sec = _this->spec.freq * _this->spec.channels * 2;
+
+    h->pipeline = p_gst_parse_launch("appsrc name=src ! mtkaudiosink render-mode=1", NULL);
+    if (!h->pipeline) {
+        return SDL_SetError("netcast audio: can't build GStreamer pipeline");
+    }
+    h->appsrc = p_gst_bin_get_by_name(h->pipeline, "src");
+    if (!h->appsrc) {
+        return SDL_SetError("netcast audio: appsrc missing");
+    }
+    SDL_snprintf(capsstr, sizeof(capsstr),
+                 "audio/x-raw-int,rate=%d,channels=%d,width=16,depth=16,signed=true,endianness=1234",
+                 _this->spec.freq, _this->spec.channels);
+    caps = p_gst_caps_from_string(capsstr);
+    p_g_object_set(h->appsrc, "caps", caps, "block", 1, "max-bytes", (Uint64)(_this->spec.size * 4), NULL);
+    p_gst_caps_unref(caps);
+    p_gst_element_set_state(h->pipeline, GST_STATE_PLAYING);
+
+    SDL_Log("netcast audio: mtkaudiosink %d Hz, %d ch, %d-sample buffers",
+            _this->spec.freq, _this->spec.channels, _this->spec.samples);
+    return 0;
+}
+
+static void NETCAST_WaitDevice(_THIS)
+{
+    /* Keep at most ~100 ms queued ahead of real time; appsrc also blocks when full. */
+    struct SDL_PrivateAudioData *h = _this->hidden;
+    Uint64 now = SDL_GetTicks64();
+    Uint64 played_ms, queued_ms;
+    if (!h->start_ms) {
+        return;
+    }
+    played_ms = now - h->start_ms;
+    queued_ms = h->bytes_pushed * 1000 / (Uint64)h->bytes_per_sec;
+    if (queued_ms > played_ms + 100) {
+        SDL_Delay((Uint32)(queued_ms - played_ms - 100));
+    } else if (played_ms > queued_ms + 500) {
+        /* underrun (e.g. app stalled): restart the reference clock */
+        h->start_ms = now;
+        h->bytes_pushed = 0;
+    }
+}
+
+static void NETCAST_PlayDevice(_THIS)
+{
+    struct SDL_PrivateAudioData *h = _this->hidden;
+    nc_GstBuffer *buf = p_gst_buffer_new_and_alloc(_this->spec.size);
+    if (!buf) {
+        return;
+    }
+    SDL_memcpy(buf->data, h->mixbuf, _this->spec.size);
+    p_gst_app_src_push_buffer(h->appsrc, buf);   /* takes ownership */
+    if (!h->start_ms) {
+        h->start_ms = SDL_GetTicks64();
+    }
+    h->bytes_pushed += _this->spec.size;
+}
+
+static Uint8 *NETCAST_GetDeviceBuf(_THIS)
+{
+    return _this->hidden->mixbuf;
+}
+
+static void NETCAST_CloseDevice(_THIS)
+{
+    struct SDL_PrivateAudioData *h = _this->hidden;
+    if (!h) {
+        return;
+    }
+    if (h->pipeline) {
+        if (h->appsrc) {
+            p_gst_app_src_end_of_stream(h->appsrc);
+            p_gst_object_unref(h->appsrc);
+        }
+        p_gst_element_set_state(h->pipeline, GST_STATE_NULL);
+        p_gst_object_unref(h->pipeline);
+    }
+    SDL_free(h->mixbuf);
+    SDL_free(h);
+    _this->hidden = NULL;
+}
+
+static SDL_bool NETCAST_Init(SDL_AudioDriverImpl *impl)
+{
+    /* Only claim availability on the TV (mtkaudiosink lives in the MTK gst plugin). */
+    if (access("/usr/local/lib/gstreamer-0.10/libgstmtkelements.so", R_OK) != 0) {
+        return SDL_FALSE;
+    }
+    impl->OpenDevice = NETCAST_OpenDevice;
+    impl->WaitDevice = NETCAST_WaitDevice;
+    impl->PlayDevice = NETCAST_PlayDevice;
+    impl->GetDeviceBuf = NETCAST_GetDeviceBuf;
+    impl->CloseDevice = NETCAST_CloseDevice;
+    impl->Deinitialize = NETCAST_UnloadGst;
+    impl->OnlyHasDefaultOutputDevice = SDL_TRUE;
+    impl->SupportsNonPow2Samples = SDL_TRUE;
+    return SDL_TRUE;
+}
+
+AudioBootStrap NETCASTAUDIO_bootstrap = {
+    "netcast", "LG NetCast mtkaudiosink (GStreamer 0.10)", NETCAST_Init, SDL_FALSE
+};
+
+#endif /* SDL_AUDIO_DRIVER_NETCAST */

--- a/src/video/netcast/SDL_netcastvideo.c	1969-12-31 19:00:00.000000000 -0500
+++ b/src/video/netcast/SDL_netcastvideo.c	2026-11-20 08:01:40.509504311 -0500
@@ -0,0 +1,371 @@
+/*
+  SDL video driver for LG NetCast 4.x TVs (MT5398, PowerVR SGX), built on libnc.
+
+  - One fullscreen 1280x720 window: the HOA window procmgr assigns to the process.
+  - OpenGL ES 2 via SDL's EGL helpers; the EGL native window is the HOA window ID.
+  - Input from libnc: evdev keyboards/remotes/mice (incl. hot-plugged USB devices),
+    mapped with SDL's Linux scancode table.
+
+  Launch apps through run-app.sh so the LG app environment is set up.
+*/
+#include "../../SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_NETCAST
+
+#include "../SDL_sysvideo.h"
+#include "../SDL_egl_c.h"
+#include "../../events/SDL_events_c.h"
+#include "../../events/SDL_keyboard_c.h"
+#include "../../events/SDL_mouse_c.h"
+#include "../../events/SDL_scancode_tables_c.h"
+#include "SDL_hints.h"
+
+#include <linux/input.h>
+#include "nc.h"
+
+#define NETCAST_W 1280
+#define NETCAST_H 720
+
+typedef struct SDL_WindowData {
+    EGLSurface egl_surface;
+    int frames;
+} SDL_WindowData;
+
+static SDL_Window *netcast_window;
+static int shift_l, shift_r, caps;
+
+/* ------------------------------------------------------------------ GLES */
+static int NETCAST_GLES_LoadLibrary(_THIS, const char *path)
+{
+    return SDL_EGL_LoadLibrary(_this, path, EGL_DEFAULT_DISPLAY, 0);
+}
+SDL_EGL_CreateContext_impl(NETCAST)
+SDL_EGL_MakeCurrent_impl(NETCAST)
+
+/* The TV composites our plane over video / LG UI using per-pixel framebuffer alpha.
+ * Many apps write alpha=0 (e.g. Doom's palette conversion) -> invisible window.
+ * Force alpha to 1 before every swap, unless NC_ALPHA_OVERLAY=1 (see-through overlays). */
+typedef void (*pfn_colormask)(unsigned char, unsigned char, unsigned char, unsigned char);
+typedef void (*pfn_clearcolor)(float, float, float, float);
+typedef void (*pfn_clear)(unsigned);
+typedef void (*pfn_getfloatv)(unsigned, float *);
+typedef void (*pfn_getbooleanv)(unsigned, unsigned char *);
+typedef unsigned char (*pfn_isenabled)(unsigned);
+typedef void (*pfn_able)(unsigned);
+static struct {
+    int inited, overlay;
+    pfn_colormask ColorMask; pfn_clearcolor ClearColor; pfn_clear Clear;
+    pfn_getfloatv GetFloatv; pfn_getbooleanv GetBooleanv; pfn_isenabled IsEnabled; pfn_able Enable, Disable;
+} opq;
+
+static void force_opaque(void)
+{
+    float cc[4];
+    unsigned char mask[4], scissor;
+    if (!opq.inited) {
+        const char *e = SDL_getenv("NC_ALPHA_OVERLAY");
+        opq.inited = 1;
+        opq.overlay = e && *e == '1';
+        opq.ColorMask = (pfn_colormask)SDL_GL_GetProcAddress("glColorMask");
+        opq.ClearColor = (pfn_clearcolor)SDL_GL_GetProcAddress("glClearColor");
+        opq.Clear = (pfn_clear)SDL_GL_GetProcAddress("glClear");
+        opq.GetFloatv = (pfn_getfloatv)SDL_GL_GetProcAddress("glGetFloatv");
+        opq.GetBooleanv = (pfn_getbooleanv)SDL_GL_GetProcAddress("glGetBooleanv");
+        opq.IsEnabled = (pfn_isenabled)SDL_GL_GetProcAddress("glIsEnabled");
+        opq.Enable = (pfn_able)SDL_GL_GetProcAddress("glEnable");
+        opq.Disable = (pfn_able)SDL_GL_GetProcAddress("glDisable");
+    }
+    if (opq.overlay || !opq.ColorMask || !opq.Clear || !opq.GetFloatv || !opq.GetBooleanv || !opq.IsEnabled) {
+        return;
+    }
+    opq.GetFloatv(0x0C22 /* GL_COLOR_CLEAR_VALUE */, cc);
+    opq.GetBooleanv(0x0C23 /* GL_COLOR_WRITEMASK */, mask);
+    scissor = opq.IsEnabled(0x0C11 /* GL_SCISSOR_TEST */);
+    if (scissor) opq.Disable(0x0C11);
+    opq.ColorMask(0, 0, 0, 1);
+    opq.ClearColor(0.f, 0.f, 0.f, 1.f);
+    opq.Clear(0x4000 /* GL_COLOR_BUFFER_BIT */);
+    opq.ColorMask(mask[0], mask[1], mask[2], mask[3]);
+    opq.ClearColor(cc[0], cc[1], cc[2], cc[3]);
+    if (scissor) opq.Enable(0x0C11);
+}
+
+typedef void (*pfn_readpixels)(int, int, int, int, unsigned, unsigned, void *);
+static int nc_debug = -1;
+static void debug_frame(SDL_Window *window, int frame)
+{
+    static pfn_readpixels ReadPixels;
+    unsigned char px[3][4];
+    uint32_t prop[16];
+    int (*get_prop)(uint32_t, void *);
+    if (frame != 1 && frame != 60 && frame != 300) return;
+    if (!ReadPixels) ReadPixels = (pfn_readpixels)SDL_GL_GetProcAddress("glReadPixels");
+    SDL_memset(px, 0, sizeof(px));
+    if (ReadPixels) {
+        ReadPixels(640, 360, 1, 1, 0x1908 /* GL_RGBA */, 0x1401 /* GL_UNSIGNED_BYTE */, px[0]);
+        ReadPixels(10, 10, 1, 1, 0x1908, 0x1401, px[1]);
+        ReadPixels(400, 500, 1, 1, 0x1908, 0x1401, px[2]);
+    }
+    SDL_memset(prop, 0, sizeof(prop));
+    get_prop = (int (*)(uint32_t, void *))nc_hoa_sym("HOA_GX_GetWindowProperty");
+    if (get_prop) get_prop(nc_window_id(), prop);
+    nc_log("netcast dbg frame %d: rgba centre %02x%02x%02x%02x corner %02x%02x%02x%02x low %02x%02x%02x%02x | win %u visible=%u flags=%08x",
+           frame, px[0][0], px[0][1], px[0][2], px[0][3], px[1][0], px[1][1], px[1][2], px[1][3],
+           px[2][0], px[2][1], px[2][2], px[2][3], nc_window_id(), prop[1], window->flags);
+}
+
+static int NETCAST_GLES_SwapWindow(_THIS, SDL_Window *window)
+{
+    SDL_WindowData *data = (SDL_WindowData *)window->driverdata;
+    int r;
+    force_opaque();
+    if (nc_debug < 0) { const char *e = SDL_getenv("NC_DEBUG"); nc_debug = e && *e == '1'; }
+    if (nc_debug) debug_frame(window, data->frames + 1);
+    r = SDL_EGL_SwapBuffers(_this, data->egl_surface);
+    if (data->frames++ == 0) {
+        nc_update_window();
+    }
+    return r;
+}
+
+/* ---------------------------------------------------------------- input */
+static char ascii_for(int code, int shift)
+{
+    static const char *row_lo = "1234567890-=", *row_hi = "!@#$%^&*()_+";
+    static const char *q_lo = "qwertyuiop[]", *a_lo = "asdfghjkl;'`", *z_lo = "zxcvbnm,./";
+    static const char *q_hi = "QWERTYUIOP{}", *a_hi = "ASDFGHJKL:\"~", *z_hi = "ZXCVBNM<>?";
+    if (code >= KEY_1 && code <= KEY_EQUAL) return (shift ? row_hi : row_lo)[code - KEY_1];
+    if (code >= KEY_Q && code <= KEY_RIGHTBRACE) return (shift ? q_hi : q_lo)[code - KEY_Q];
+    if (code >= KEY_A && code <= KEY_GRAVE) return (shift ? a_hi : a_lo)[code - KEY_A];
+    if (code >= KEY_Z && code <= KEY_SLASH) return (shift ? z_hi : z_lo)[code - KEY_Z];
+    if (code == KEY_BACKSLASH) return shift ? '|' : '\\';
+    if (code == KEY_SPACE) return ' ';
+    return 0;
+}
+
+static void handle_key(int code, int value)
+{
+    Uint8 state = value ? SDL_PRESSED : SDL_RELEASED;
+    if (code == BTN_LEFT || code == BTN_RIGHT || code == BTN_MIDDLE) {
+        Uint8 b = code == BTN_LEFT ? SDL_BUTTON_LEFT : code == BTN_RIGHT ? SDL_BUTTON_RIGHT : SDL_BUTTON_MIDDLE;
+        if (value != 2) SDL_SendMouseButton(netcast_window, 0, state, b);
+        return;
+    }
+    if (code == KEY_LEFTSHIFT) shift_l = value != 0;
+    if (code == KEY_RIGHTSHIFT) shift_r = value != 0;
+    if (code == KEY_CAPSLOCK && value == 1) caps = !caps;
+
+    SDL_Scancode sc = SDL_GetScancodeFromTable(SDL_SCANCODE_TABLE_LINUX, code);
+    /* LG remote keys with no SDL equivalent: map to generic keys apps can bind. */
+    switch (code) {
+    case KEY_CHANNELUP:   sc = SDL_SCANCODE_PAGEUP; break;     /* CH+ */
+    case KEY_CHANNELDOWN: sc = SDL_SCANCODE_PAGEDOWN; break;   /* CH- (Back arrives as KEY_ESC from libnc) */
+    case KEY_RED:         sc = SDL_SCANCODE_F1; break;
+    case KEY_GREEN:       sc = SDL_SCANCODE_F2; break;
+    case KEY_YELLOW:      sc = SDL_SCANCODE_F3; break;
+    case KEY_BLUE:        sc = SDL_SCANCODE_F4; break;
+    default: break;
+    }
+    if (sc == SDL_SCANCODE_UNKNOWN) {
+        /* TODO: map LG remote-specific codes (e.g. Back) here once identified */
+        static unsigned char logged[1024];
+        if (code >= 0 && code < 1024 && !logged[code]) {
+            logged[code] = 1;
+            nc_log("netcast: unmapped evdev key code %d", code);
+        }
+        return;
+    }
+    SDL_SendKeyboardKey(state, sc);   /* value 2 (autorepeat) -> another press */
+
+    if (value && SDL_EventState(SDL_TEXTINPUT, SDL_QUERY)) {
+        int shift = shift_l || shift_r;
+        char c = ascii_for(code, shift);
+        if (c >= 'a' && c <= 'z' && caps) c = (char)(c - 32);
+        else if (c >= 'A' && c <= 'Z' && caps) c = (char)(c + 32);
+        if (c) {
+            char text[2] = { c, 0 };
+            SDL_SendKeyboardText(text);
+        }
+    }
+}
+
+static void NETCAST_PumpEvents(_THIS)
+{
+    nc_event e;
+    while (nc_poll(&e, 0)) {
+        switch (e.type) {
+        case NC_EV_KEY:
+            handle_key(e.code, e.value);
+            break;
+        case NC_EV_REL:
+            if (e.code == REL_X) SDL_SendMouseMotion(netcast_window, 0, 1, e.value, 0);
+            else if (e.code == REL_Y) SDL_SendMouseMotion(netcast_window, 0, 1, 0, e.value);
+            else if (e.code == REL_WHEEL) SDL_SendMouseWheel(netcast_window, 0, 0.0f, (float)e.value, SDL_MOUSEWHEEL_NORMAL);
+            else if (e.code == REL_HWHEEL) SDL_SendMouseWheel(netcast_window, 0, (float)e.value, 0.0f, SDL_MOUSEWHEEL_NORMAL);
+            break;
+        case NC_EV_QUIT:
+            SDL_SendQuit();
+            break;
+        default:
+            break;
+        }
+    }
+}
+
+/* ---------------------------------------------------------------- video */
+/* LG's libdbgfrwk swallows stdout/stderr once loaded: send SDL_Log through libnc. */
+static void NETCAST_LogOutput(void *userdata, int category, SDL_LogPriority priority, const char *message)
+{
+    nc_log("%s", message);
+}
+
+static int NETCAST_VideoInit(_THIS)
+{
+    SDL_VideoDisplay display;
+    SDL_DisplayMode mode;
+    nc_config cfg;
+    const char *t = SDL_getenv("NC_TIMEOUT");
+
+    SDL_zero(cfg);
+    cfg.no_egl = 1;   /* SDL's EGL code creates the surface/context */
+    cfg.timeout_s = t ? SDL_atoi(t) : 0;
+    if (nc_init(&cfg) != 0) {
+        return SDL_SetError("netcast: libnc init failed (launched via run-app.sh?)");
+    }
+    SDL_LogSetOutputFunction(NETCAST_LogOutput, NULL);
+
+    SDL_zero(mode);
+    mode.format = SDL_PIXELFORMAT_ARGB8888;
+    mode.w = NETCAST_W;
+    mode.h = NETCAST_H;
+    mode.refresh_rate = 60;
+    SDL_zero(display);
+    display.desktop_mode = mode;
+    display.current_mode = mode;
+    if (SDL_AddVideoDisplay(&display, SDL_FALSE) < 0) {
+        return -1;
+    }
+    return 0;
+}
+
+static void NETCAST_VideoQuit(_THIS)
+{
+    nc_shutdown();
+}
+
+static void NETCAST_GetDisplayModes(_THIS, SDL_VideoDisplay *display)
+{
+    SDL_AddDisplayMode(display, &display->current_mode);
+}
+
+static int NETCAST_SetDisplayMode(_THIS, SDL_VideoDisplay *display, SDL_DisplayMode *mode)
+{
+    return 0;
+}
+
+static int NETCAST_CreateWindow(_THIS, SDL_Window *window)
+{
+    SDL_WindowData *data;
+
+    if (netcast_window) {
+        return SDL_SetError("netcast: only one window is supported");
+    }
+    data = (SDL_WindowData *)SDL_calloc(1, sizeof(SDL_WindowData));
+    if (!data) {
+        return SDL_OutOfMemory();
+    }
+    window->driverdata = data;
+    /* the HOA window is fixed: fullscreen 1280x720 */
+    window->x = 0;
+    window->y = 0;
+    window->w = NETCAST_W;
+    window->h = NETCAST_H;
+    window->flags |= SDL_WINDOW_FULLSCREEN | SDL_WINDOW_SHOWN | SDL_WINDOW_INPUT_FOCUS | SDL_WINDOW_MOUSE_FOCUS;
+    window->flags &= ~SDL_WINDOW_RESIZABLE;
+
+    if (!_this->egl_data && SDL_GL_LoadLibrary(NULL) < 0) {
+        return -1;
+    }
+    data->egl_surface = SDL_EGL_CreateSurface(_this, (NativeWindowType)(uintptr_t)nc_window_id());
+    if (data->egl_surface == EGL_NO_SURFACE) {
+        return SDL_SetError("netcast: can't create EGL surface on window %u", nc_window_id());
+    }
+    netcast_window = window;
+    /* SDL_CreateRenderer recreates non-GL windows (Hide + Create); SDL won't call
+     * ShowWindow again because we report SHOWN, so make the HOA window visible here. */
+    nc_set_visible(1);
+    if (nc_debug < 0) { const char *e = SDL_getenv("NC_DEBUG"); nc_debug = e && *e == '1'; }
+    if (nc_debug) nc_log("netcast: CreateWindow flags=%08x", window->flags);
+    SDL_SetMouseFocus(window);
+    SDL_SetKeyboardFocus(window);
+    return 0;
+}
+
+static void NETCAST_DestroyWindow(_THIS, SDL_Window *window)
+{
+    SDL_WindowData *data = (SDL_WindowData *)window->driverdata;
+    if (data) {
+        if (data->egl_surface != EGL_NO_SURFACE) {
+            SDL_EGL_MakeCurrent(_this, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+            SDL_EGL_DestroySurface(_this, data->egl_surface);
+        }
+        SDL_free(data);
+        window->driverdata = NULL;
+    }
+    if (window == netcast_window) {
+        netcast_window = NULL;
+    }
+}
+
+static void NETCAST_ShowWindow(_THIS, SDL_Window *window) { if (nc_debug == 1) nc_log("netcast: ShowWindow"); nc_set_visible(1); }
+static void NETCAST_HideWindow(_THIS, SDL_Window *window) { if (nc_debug == 1) nc_log("netcast: HideWindow"); nc_set_visible(0); }
+static void NETCAST_SetWindowFullscreen(_THIS, SDL_Window *window, SDL_VideoDisplay *display, SDL_bool fullscreen)
+{
+    if (nc_debug == 1) nc_log("netcast: SetWindowFullscreen(%d)", fullscreen);
+}
+static void NETCAST_MinimizeWindow(_THIS, SDL_Window *window) { if (nc_debug == 1) nc_log("netcast: MinimizeWindow (ignored)"); }
+
+static void NETCAST_DeleteDevice(SDL_VideoDevice *device)
+{
+    SDL_free(device);
+}
+
+static SDL_VideoDevice *NETCAST_CreateDevice(void)
+{
+    SDL_VideoDevice *device = (SDL_VideoDevice *)SDL_calloc(1, sizeof(SDL_VideoDevice));
+    if (!device) {
+        SDL_OutOfMemory();
+        return NULL;
+    }
+    device->free = NETCAST_DeleteDevice;
+    device->VideoInit = NETCAST_VideoInit;
+    device->VideoQuit = NETCAST_VideoQuit;
+    device->GetDisplayModes = NETCAST_GetDisplayModes;
+    device->SetDisplayMode = NETCAST_SetDisplayMode;
+    device->CreateSDLWindow = NETCAST_CreateWindow;
+    device->DestroyWindow = NETCAST_DestroyWindow;
+    device->ShowWindow = NETCAST_ShowWindow;
+    device->HideWindow = NETCAST_HideWindow;
+    device->SetWindowFullscreen = NETCAST_SetWindowFullscreen;
+    device->MinimizeWindow = NETCAST_MinimizeWindow;
+    device->PumpEvents = NETCAST_PumpEvents;
+
+    device->GL_LoadLibrary = NETCAST_GLES_LoadLibrary;
+    device->GL_GetProcAddress = SDL_EGL_GetProcAddress;
+    device->GL_UnloadLibrary = SDL_EGL_UnloadLibrary;
+    device->GL_CreateContext = NETCAST_GLES_CreateContext;
+    device->GL_MakeCurrent = NETCAST_GLES_MakeCurrent;
+    device->GL_SetSwapInterval = SDL_EGL_SetSwapInterval;
+    device->GL_GetSwapInterval = SDL_EGL_GetSwapInterval;
+    device->GL_SwapWindow = NETCAST_GLES_SwapWindow;
+    device->GL_DeleteContext = SDL_EGL_DeleteContext;
+    return device;
+}
+
+VideoBootStrap NETCAST_bootstrap = {
+    "netcast", "LG NetCast (HOA GX + PowerVR EGL)",
+    NETCAST_CreateDevice,
+    NULL /* no ShowMessageBox */
+};

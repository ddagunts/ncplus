From 9ba7fadf3d43d355d64749f04391f6e68aa1d10c Mon Sep 17 00:00:00 2001
From: Dmitry Dagunts <ddagunts@gmail.com>
Date: Mon, 23 Nov 2026 23:16:02 -0500
Subject: [PATCH 3/3] Report LG's DDK build, 1.9@2291151

SGXDevInitCompatCheck compares the microkernel's DDK version and build with
the kernel module's and refuses on any difference. The microkernel comes
with the TV's userspace (libsrv_init.so, 1.9@2291151), so the module has to
carry that build number. LG's pvrsrvkm.ko has 0x10913 (1.9, branch 19) and
0x22f5cf (2291151) in SGXDevInitCompatCheck, and the version string
"SGX_DDK_Linux sgxddk 19 1.9@2291151".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include4/pvrversion.h | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/include4/pvrversion.h b/include4/pvrversion.h
index ca8bead..0b9637d 100644
--- a/include4/pvrversion.h
+++ b/include4/pvrversion.h
@@ -58,16 +58,16 @@ CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
 
 #define PVRVERSION_FAMILY           "sgxddk"
 #define PVRVERSION_BRANCHNAME       "1.9"
-#define PVRVERSION_BUILD             2253347
-#define PVRVERSION_BSCONTROL        "SGX_DDK_Linux_CustomerTI"
+#define PVRVERSION_BUILD             2291151
+#define PVRVERSION_BSCONTROL        "SGX_DDK_Linux"
 
-#define PVRVERSION_STRING           "SGX_DDK_Linux_CustomerTI sgxddk 19 1.9@" PVR_STR2(PVRVERSION_BUILD)
+#define PVRVERSION_STRING           "SGX_DDK_Linux sgxddk 19 1.9@" PVR_STR2(PVRVERSION_BUILD)
 #define PVRVERSION_STRING_SHORT     "1.9@" PVR_STR2(PVRVERSION_BUILD)
 
 #define COPYRIGHT_TXT               "Copyright (c) Imagination Technologies Ltd. All Rights Reserved."
 
-#define PVRVERSION_BUILD_HI          225
-#define PVRVERSION_BUILD_LO          3347
+#define PVRVERSION_BUILD_HI          229
+#define PVRVERSION_BUILD_LO          1151
 #define PVRVERSION_STRING_NUMERIC    PVR_STR2(PVRVERSION_MAJ) "." PVR_STR2(PVRVERSION_MIN) "." PVR_STR2(PVRVERSION_BUILD_HI) "." PVR_STR2(PVRVERSION_BUILD_LO)
 
 #endif /* _PVRVERSION_H_ */

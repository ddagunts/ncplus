diff --git a/services4/srvkm/env/linux/mm.c b/services4/srvkm/env/linux/mm.c
index 095529f..4dcc223 100644
--- a/services4/srvkm/env/linux/mm.c
+++ b/services4/srvkm/env/linux/mm.c
@@ -63,6 +63,8 @@ CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
 #endif
 #include <linux/slab.h>
 #include <linux/highmem.h>
+#include <asm/cacheflush.h>
+#include <asm/outercache.h>
 #include <linux/sched.h>
 
 #if defined(PVR_LINUX_MEM_AREA_POOL_ALLOW_SHRINK)
@@ -483,8 +485,48 @@ _VMallocWrapper(IMG_UINT32 ui32Bytes,
             return NULL;
     }
 
-	/* Allocate virtually contiguous pages */
-    pvRet = __vmalloc(ui32Bytes, GFP_KERNEL | __GFP_HIGHMEM, PGProtFlags);
+	/*
+	 * Allocate virtually contiguous pages. __vmalloc() lost its pgprot argument in
+	 * Linux 5.8, so uncached and write-combined areas are built from pages and vmap()ed;
+	 * VM_MAP_PUT_PAGES makes vfree() release the pages and the array.
+	 */
+    if ((ui32AllocFlags & PVRSRV_HAP_CACHETYPE_MASK) == PVRSRV_HAP_CACHED)
+    {
+        pvRet = vmalloc(ui32Bytes);
+    }
+    else
+    {
+        unsigned int uiPages = PAGE_ALIGN(ui32Bytes) >> PAGE_SHIFT, ui;
+        struct page **ppsPages = kvmalloc_array(uiPages, sizeof(*ppsPages), GFP_KERNEL);
+
+        pvRet = NULL;
+        if (ppsPages)
+        {
+            for (ui = 0; ui < uiPages; ui++)
+            {
+                IMG_VOID *pvPage;
+                phys_addr_t uPhys;
+
+                ppsPages[ui] = alloc_page(GFP_KERNEL | __GFP_HIGHMEM);
+                if (!ppsPages[ui])
+                    break;
+                /* no dirty cache lines may be left behind the uncached alias */
+                pvPage = kmap_local_page(ppsPages[ui]);
+                __cpuc_flush_dcache_area(pvPage, PAGE_SIZE);
+                kunmap_local(pvPage);
+                uPhys = page_to_phys(ppsPages[ui]);
+                outer_flush_range(uPhys, uPhys + PAGE_SIZE);
+            }
+            if (ui == uiPages)
+                pvRet = vmap(ppsPages, uiPages, VM_MAP | VM_MAP_PUT_PAGES, PGProtFlags);
+            if (!pvRet)
+            {
+                while (ui--)
+                    __free_page(ppsPages[ui]);
+                kvfree(ppsPages);
+            }
+        }
+    }
     
 #if defined(DEBUG_LINUX_MEMORY_ALLOCATIONS)
     if (pvRet)
@@ -533,7 +575,7 @@ _VMapWrapper(struct page **ppsPageList, IMG_UINT32 ui32NumPages, IMG_UINT32 ui32
             return NULL;
     }
 
-    pvRet = vmap(ppsPageList, ui32NumPages, GFP_KERNEL | __GFP_HIGHMEM, PGProtFlags);
+    pvRet = vmap(ppsPageList, ui32NumPages, VM_MAP, PGProtFlags);
 
 #if defined(DEBUG_LINUX_MEMORY_ALLOCATIONS)
     if (pvRet)

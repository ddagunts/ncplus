# pvrsrvkm (SGX DDK 1.9 services, TI's open release) for the MT5398, built out of tree
# against the mainline kernel by third_party/build-sgx.sh. The source list is LG's
# (the compile units in its pvrsrvkm.ko), with a Linux platform driver.

obj-m := pvrsrvkm.o

ccflags-y += -D__linux__ -include $(src)/config_kernel.h \
	-DDEBUG_LOG_PATH_TRUNCATE=\"$(src)\" \
	-I$(src)/include4 \
	-I$(src)/services4/include \
	-I$(src)/services4/system/mt5398 \
	-I$(src)/services4/system/include \
	-I$(src)/services4/srvkm/bridged \

# Kconfig fragment for the MT5398 mainline kernel, applied on top of allnoconfig
# (KCONFIG_ALLCONFIG). Phase 1: boot to an initramfs shell on the panel, plus restart and
# a RAM log that survives it.

# Platform: generic DT machine. ARCH_ZYNQ is only here because it selects the A9
# GIC + global timer (hidden symbols); its machine code runs only for Zynq boards.
# ARCH_MT5398 (src/mainline/kernel/arch/arm/mach-mt5398) is the CPU1 enable-method.
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_ZYNQ=y
CONFIG_ARCH_MT5398=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_HIGHMEM=y
CONFIG_VMSPLIT_3G=y
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y
CONFIG_CACHE_L2X0=y
# Cortex-A9 r3p0 errata
CONFIG_ARM_ERRATA_754322=y
CONFIG_ARM_ERRATA_764319=y
CONFIG_ARM_ERRATA_775420=y
# ...and the MPCore one (all revisions, two or more cores)
CONFIG_ARM_ERRATA_764369=y
CONFIG_HZ_100=y
# The static busybox (old glibc) calls the kuser helpers at 0xffff0fxx: without them init SIGSEGVs.
CONFIG_KUSER_HELPERS=y
# ...and its nanosleep/clock_gettime are the *_time32 syscalls: without this, sleep returns at once.
CONFIG_COMPAT_32BIT_TIME=y

# Core
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# Console on the panel: simplefb over the OSD plane 3 bitmap until the KMS driver takes over
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# KMS on OSD plane 3 (src/mainline/kernel/drivers/gpu/drm/tiny/mt5398_osd.c): takes the panel
# over from simplefb at boot, /dev/dri/card0 for Xorg/Wayland, fbcon moves to its fbdev.
# Scanout buffers come from a CMA pool in the DTS (osd-pool).
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_MT5398_OSD=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y

# The MICOM (lg-micom.c) on SIF bus 2 (i2c-mt5398-sif.c), /dev/i2c-0 for i2c-tools.
# Panel backlight (lg-micom-bl.c): mt5398_osd switches it with DPMS, /sys/class/backlight/micom.
# IR remote (lg-micom-ir.c): an ordinary input device, "LG NetCast remote".
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MT5398_SIF=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_MFD_LG_MICOM=y
CONFIG_BACKLIGHT_LG_MICOM=y
CONFIG_RC_CORE=y
CONFIG_RC_DEVICES=y
CONFIG_IR_LG_MICOM=y

# SGX544 identify/reset (src/mainline/kernel/drivers/misc/mt5398_sgx.c), sysfs-triggered
CONFIG_MT5398_SGX=y

# Restart via the PDWNC watchdog (two syscon-reboot nodes in the DTS)
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
# /dev/mem for busybox devmem (watchdog experiments from init)
CONFIG_DEVMEM=y

# RAM log: console + oops + /dev/pmsg0 into ramoops, read back from stock after the reset
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# CONFIG_PSTORE_COMPRESS is not set

# USB host: the four MUSB ports behind the BIM interrupt gate (drivers in src/mainline/kernel)
CONFIG_MT5398_BIM=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_HOST=y
CONFIG_USB_MUSB_MT5398=y
CONFIG_MUSB_PIO_ONLY=y

# USB Ethernet adapters (network for phase 2) + what busybox udhcpc/telnetd need
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_SMSC95XX=y

# USB keyboard -> the panel's VT, for a local shell
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# USB storage (later: a Debian root on a stick)
CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y

# Debian root: an ext4 image file on the stick's FAT partition, loop-mounted by the
# initramfs (netcast/mainline/debian.img), then switch_root into systemd.
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=2
# allnoconfig turns this off, and then a block device that is open for writing can't be
# mounted (-EBUSY): busybox `mount -o loop` keeps /dev/loop0 open rw across mount(2).
CONFIG_BLK_DEV_WRITE_MOUNTED=y
# what systemd and Debian's units expect (allnoconfig drops these)
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_INOTIFY_USER=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_IPV6=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y

# Xfce desktop (lightdm + Xorg modesetting): ~680 MB usable RAM and no disk worth swapping
# to, so swap on zram (systemd-zram-generator, lz4); user namespaces for Firefox's
# sandbox; wireless keyboard/mouse receivers that hid-generic doesn't handle.
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_USER_NS=y
# (hid-logitech and hid-apple drive keyboard LEDs through the LED class)
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_HID_LOGITECH=y
CONFIG_HIDRAW=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_LOGITECH_HIDPP=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_APPLE=y

# /dev/watchdog on the PDWNC timer (src/mainline/kernel/drivers/watchdog): a hung Debian
# boot resets to stock instead of needing a power cycle
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_MT5398_WATCHDOG=y

# Wi-Fi: USB dongles on carl9170 (Atheros AR9170, e.g. the Netgear WN111v2 0846:9001; the
# TV's own Broadcom 043e:3005 has no mainline driver). Everything is built in, so the dongle
# probes inside the initramfs, before Debian's /lib/firmware exists: its firmware and the
# regulatory database (+ signature, which cfg80211 insists on without CERTIFICATION_ONUS)
# go into the Image (EXTRA_FIRMWARE, fetched by build-mainline.sh into third_party/mainline/firmware).
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CARL9170=y
CONFIG_MAC80211_LEDS=y
CONFIG_CARL9170_LEDS=y
CONFIG_FW_LOADER=y
CONFIG_EXTRA_FIRMWARE="carl9170-1.fw regulatory.db regulatory.db.p7s"
# the regdb signature: PKCS#7, RSA + SHA-256
CONFIG_CRYPTO_RSA=y
CONFIG_CRYPTO_SHA256=y

# Loadable modules: the SGX544 services driver (pvrsrvkm, PowerVR DDK 1.9) is built out of
# tree by third_party/build-sgx.sh
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# TV speakers: ALSA on the audio DSP that stock leaves running
# (src/mainline/kernel/sound/arm/mt5398-mixsnd.c)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_PROC_FS=y
CONFIG_SND_ARM=y
CONFIG_SND_MT5398_MIXSND=y

# Bluetooth keyboards (and mice), all as loadable modules: not in the Image, they live in
# Debian's /lib/modules (build-mainline.sh modules -> out/modules). btusb covers USB adapters
# (the vendor helpers load firmware patches when the adapter needs them); hidp = classic
# (BR/EDR) HID keyboards, uhid = BLE (HOGP) keyboards through bluetoothd. Userspace: bluez.
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_AUTOSUSPEND=n
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_UHID=m
# bluetoothd's AF_ALG crypto (signed GATT writes, LE privacy)
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m

# Network shares, as loadable modules in Debian's /lib/modules: an SMB 2.1/3.x client (cifs; SMB 1
# and 2.0 stay off) and an NFS client (v3, v4.0-4.2). Userspace: cifs-utils, nfs-common.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_CIFS=m
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_DEBUG=y
CONFIG_CIFS_DFS_UPCALL=y
CONFIG_NFS_FS=m
CONFIG_NFS_V3=m
CONFIG_NFS_V3_ACL=y
CONFIG_NFS_V4=m
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y

# wpa_supplicant on Wi-Fi interface %I, started by udev (80-netcast-wifi.rules). Its config
# is made from wifi.conf at the root of the stick (netcast-wifi); no file = not started.
# systemd-networkd does DHCP once it is associated (25-wireless.network).
[Unit]
Description=Wi-Fi on %I (wifi.conf on the stick)
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device
Before=network.target
Wants=network.target

[Service]
Type=simple
ExecCondition=/usr/local/sbin/netcast-wifi /run/netcast-wifi/%I.conf
ExecStart=/usr/sbin/wpa_supplicant -s -D nl80211 -i %I -c /run/netcast-wifi/%I.conf
Restart=on-failure
RestartSec=5

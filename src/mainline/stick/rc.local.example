# EXAMPLE: this file is not read. Copy it to "rc.local" in the same folder
# (the root of the stick, next to the "netcast" folder; no ".example" or ".txt" at the end)
# and edit the copy. Unzipping a newer release leaves the copy alone.
#
# Debian runs rc.local at every boot, as root, with bash. It starts once the network,
# Bluetooth and sound services have started (the network itself may not be up yet: the
# examples wait for it). The desktop doesn't wait for it, so slow steps are fine; put the
# slowest in the background with "&" as the examples do, so one doesn't hold up the next.
#
# Its output goes to rc.local.log beside it (new at every boot) and to the journal:
#   sudo journalctl -b -u netcast-rclocal
# Windows line endings are fine. In Debian this file is /mnt/stick/rc.local; after editing
# it, reboot or run: sudo systemctl restart netcast-rclocal
#
# Remove the "#" in front of the lines you want and put in your own names and addresses.
# Leave the helpers below as they are. Uncomment "set -x" to log each command as it runs.
#set -x

# wait_for <seconds> <command...>: retry the command every 2 s until it succeeds or time is up
wait_for() {
	local end=$((SECONDS + $1)); shift
	until "$@" >/dev/null 2>&1; do
		[ "$SECONDS" -ge "$end" ] && { echo "gave up waiting for: $*"; return 1; }
		sleep 2
	done
}
network_up() { ip route show default | grep -q .; }
# as_tv <command...>: run as the desktop user tv, in its session (PipeWire, ...)
as_tv() { runuser -u tv -- env XDG_RUNTIME_DIR=/run/user/1000 "$@"; }
bt_ready() { bluetoothctl list | grep -q Controller && bluetoothctl power on; }
bt_connected() {
	bluetoothctl info "$1" | grep -q 'Connected: yes' && return 0
	bluetoothctl --timeout 10 connect "$1"
	bluetoothctl info "$1" | grep -q 'Connected: yes'
}


# ---- Mount filesystems --------------------------------------------------------------------
# A USB disk by its label (FAT32 or ext4; the kernel has no exFAT or NTFS). See the labels
# with: lsblk -f
#   FAT32: owned by tv (user and group 1000), so the desktop user can write to it
#mkdir -p /mnt/disk
#wait_for 30 test -e /dev/disk/by-label/MYDISK && mount -o noatime,uid=1000,gid=1000 LABEL=MYDISK /mnt/disk
#   ext4: keeps its own owners
#mkdir -p /mnt/data
#wait_for 30 test -e /dev/disk/by-label/data && mount -o noatime LABEL=data /mnt/data

# A Samba or Windows share (SMB 2.1/3), once the network is up. The password is stored
# unencrypted on the stick. If it has a comma in it, use credentials=<file> instead.
#mkdir -p /mnt/share
#{ wait_for 90 network_up &&
#  mount -t cifs //192.168.1.20/music /mnt/share -o username=me,password=secret,uid=tv,gid=tv; } &

# An NFS export (v4; for an NFS v3 server add ",nolock" after "soft").
#mkdir -p /mnt/nfs
#{ wait_for 90 network_up && mount -t nfs -o soft 192.168.1.20:/export/music /mnt/nfs; } &



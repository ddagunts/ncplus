diff -ruN a/sound/arm/Kconfig b/sound/arm/Kconfig
--- a/sound/arm/Kconfig
+++ b/sound/arm/Kconfig
@@ -28,6 +28,17 @@
 	  Say Y or M if you want to support any AC97 codec attached to
 	  the PXA2xx AC97 interface.

+config SND_MT5398_MIXSND
+	tristate "MediaTek MT5398 audio DSP (LG NetCast TV speakers)"
+	depends on OF
+	select SND_PCM
+	help
+	  PCM playback through the MT5398 audio DSP that LG's stock firmware
+	  leaves running when Linux is warm-booted from it (nckexec). Feeds
+	  one of the DSP's mixer channels; the DSP, codec and amplifier stay
+	  as the stock kernel configured them. Refuses to probe if the DSP is
+	  not in that state.
+
 endif	# SND_ARM

 config SND_PXA2XX_LIB
diff -ruN a/sound/arm/Makefile b/sound/arm/Makefile
--- a/sound/arm/Makefile
+++ b/sound/arm/Makefile
@@ -12,3 +12,6 @@

 obj-$(CONFIG_SND_PXA2XX_AC97)	+= snd-pxa2xx-ac97.o
 snd-pxa2xx-ac97-y		:= pxa2xx-ac97.o
+
+obj-$(CONFIG_SND_MT5398_MIXSND)	+= snd-mt5398-mixsnd.o
+snd-mt5398-mixsnd-y		:= mt5398-mixsnd.o
